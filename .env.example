# Server-only, self-hosted Supabase internal/private endpoint.
SUPABASE_URL=http://kong:8000
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI extraction is explicitly enabled only with an approved data path.
# No live API call is made by tests. Do not use real PII without the agreed controls.
OPENAI_API_KEY=
# Set a model available to your account that supports strict Chat Completions schemas.
OPENAI_EXTRACTION_MODEL=
OPENAI_EXTRACTION_ENABLED=false

# JSON maps of key IDs to distinct random secrets, at least 32 bytes each.
# Example shape only: {"payment-v1":"<random secret>"}
PAYMENT_SIM_SIGNING_KEYS_JSON=
APPROVAL_SIM_SIGNING_KEYS_JSON=

# Optional Make forwarding authentication; origin signature always remains required.
MAKE_FORWARDING_ENABLED=false
MAKE_FORWARDING_SIGNING_KEYS_JSON=

# Browser-visible Supabase gateway and ANON key only (never the service key).
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Must match browser Origin exactly. Production must use your HTTPS origin.
APP_ORIGIN=http://localhost:3000
# Provision an organization with trusted SQL; signup cannot create operator roles.
PILOT_ORGANIZATION_ID=

# Private scanner adapter: accepts PDF/TXT bytes with Bearer token;
# returns JSON {"status":"clean","sha256":"<hash of these exact bytes>"}.
# Missing scanner fails closed. Host this adapter in your approved deployment.
DOCUMENT_SCAN_URL=
DOCUMENT_SCAN_TOKEN=

# Operator-triggered DEMO confirmation, separately enabled. No real banking API.
SIMULATION_ACTIONS_ENABLED=false
SIMULATOR_CALLBACK_ORIGIN=http://localhost:3000
# Must be a key ID in PAYMENT_SIM_SIGNING_KEYS_JSON.
PAYMENT_SIM_ACTIVE_KEY_ID=
